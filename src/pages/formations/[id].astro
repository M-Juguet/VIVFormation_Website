---
/* Page type : fiche détaillée d'une formation (reprise de la version 0, Formation.dc.html). */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import FormationCard from '../../components/FormationCard.astro';
import Badge from '../../components/ds/Badge.astro';
import Button from '../../components/ds/Button.astro';
import Callout from '../../components/ds/Callout.astro';
import Card from '../../components/ds/Card.astro';
import Icon from '../../components/ds/Icon.astro';
import ObjectivesPanel from '../../components/ds/ObjectivesPanel.astro';
import ProgramSteps from '../../components/ds/ProgramSteps.astro';
import SoftwareRequirements from '../../components/ds/SoftwareRequirements.astro';
import {
  formatDate,
  formationsProches,
  getFormations,
  programmeSteps,
  resolveFormation,
  type FormationResolue,
} from '../../lib/formations';

export const getStaticPaths = (async () => {
  const toutes = await Promise.all((await getFormations()).map(resolveFormation));
  return toutes.map((item) => ({
    params: { id: item.formation.id },
    props: { item, proches: formationsProches(item, toutes) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  item: FormationResolue;
  proches: FormationResolue[];
}

const { item, proches } = Astro.props;
const f = item.formation.data;
const { Content } = await render(item.formation);

// Le fil d'Ariane renvoie au catalogue filtré sur le domaine de la formation.
const catalogueDomaine = `/catalogue/?domaine=${item.domaine.id}`;

const faits = [
  { icon: 'clock', label: item.duree },
  { icon: 'niveau', label: `Niveau : ${f.niveau}` },
  { icon: 'users', label: item.participants },
  { icon: 'map-pin', label: 'Présentiel — vos locaux ou notre salle' },
  { icon: 'diploma', label: 'Attestation de fin de formation' },
] as const;

const prerequis = f.prerequis.elements.map((e) => ({
  label: e.libelle,
  value: e.valeur,
  mono: e.code,
}));
---

<BaseLayout title={f.titre} description={f.resume}>
  <section class="viv-section bg-surface-brand text-ink" data-theme="sombre">
    <div class="viv-wrap">
      <nav aria-label="Fil d’Ariane" class="body-sm">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="text-ink-muted no-underline hover:text-ink">
              Accueil
            </a>
          </li>
          <li aria-hidden="true" class="flex text-ink-subtle">
            <Icon name="chevron-right" size={16} />
          </li>
          <li>
            <a href="/catalogue/" class="text-ink-muted no-underline hover:text-ink">
              Catalogue
            </a>
          </li>
          <li aria-hidden="true" class="flex text-ink-subtle">
            <Icon name="chevron-right" size={16} />
          </li>
          <li>
            <a href={catalogueDomaine} class="text-ink-muted no-underline hover:text-ink">
              {item.domaine.data.label}
            </a>
          </li>
        </ol>
      </nav>

      <div class="viv-split viv-split--aside-lg mt-8">
        <div>
          <p class="overline text-ink-muted">{item.overline}</p>
          <h1 class="display-lg mt-2 mb-5 text-balance">{f.titre}</h1>
          <div class="mb-6 flex flex-wrap gap-2">
            {item.badges.map((b) => (
              <Badge tone={b.tone}>{b.label}</Badge>
            ))}
          </div>
          <div class="viv-prose body-lg max-w-[64ch] text-pretty text-ink-muted">
            <Content />
          </div>
        </div>

        <div class="viv-glass p-6">
          <ul class="mb-5 flex flex-col gap-3">
            {faits.map((r) => (
              <li class="flex items-start gap-3">
                <span class="flex pt-0.5 text-action">
                  <Icon name={r.icon} />
                </span>
                <span class="body">{r.label}</span>
              </li>
            ))}
          </ul>
          <div class="mb-5 flex flex-wrap items-baseline gap-3 border-y border-border py-4">
            {item.tarif ? (
              <>
                <span class="display-md">{item.tarif}</span>
                <span class="caption text-ink-muted">
                  net de taxe, par participant, inter-entreprises
                </span>
              </>
            ) : (
              <span class="display-md">Sur devis</span>
            )}
          </div>
          <Button href="#demande" icon="calendar" class="w-full">
            Demander des dates
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="viv-section bg-surface">
    <div class="viv-wrap viv-split viv-split--aside">
      <div class="min-w-0">
        <ObjectivesPanel
          intro="À l’issue de la formation, au poste de travail, vous êtes en mesure de :"
          items={f.objectifs}
        />

        <h2 class="heading-lg mt-12 mb-6">Programme</h2>
        <ProgramSteps steps={programmeSteps(item.formation)} />

        <h2 class="heading-lg mt-12 mb-6">Prérequis techniques</h2>
        <SoftwareRequirements
          title={`Prérequis techniques — ${item.outils[0]?.data.label ?? 'poste de travail'}`}
          version={f.prerequis.version}
          items={prerequis}
          note="Les droits d’installation sur les postes dépendent de votre service informatique : prévoyez la validation avant la première journée."
        />

        {f.misAJour && (
          <p class="caption mt-12 text-ink-muted">
            Fiche mise à jour le {formatDate(f.misAJour)} — la version du logiciel est vérifiée
            avant chaque session.
          </p>
        )}
      </div>

      <aside class="viv-sticky-aside sticky top-[116px] flex flex-col gap-5 self-start">
        <Card overline="Tarifs" title="Inter-entreprises">
          <p>{item.tarif ? `${item.tarif} net de taxe par participant` : 'Sur devis'}</p>
          <p class="caption mt-1 text-ink-muted">Tarif établi à partir d’un effectif minimum.</p>
          <h3 class="viv-card__title mt-5">Intra-entreprise</h3>
          <p class="mt-2">Sur devis, dans vos locaux.</p>
        </Card>
        <Card overline="Modalités" title="Évaluation et suivi">
          <p>
            Quiz et exercice pratique en fin de formation, attestation remise à chaque participant.
            Un entretien de suivi deux semaines après la session.
          </p>
        </Card>
        <Callout tone="info" title="Financement">
          <p>Prise en charge OPCO et plan de développement des compétences de votre entreprise.</p>
        </Callout>
      </aside>
    </div>
  </section>

  {proches.length > 0 && (
    <section class="viv-section bg-surface-sunken">
      <div class="viv-wrap">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="overline text-ink-muted">Pour aller plus loin</p>
            <h2 class="display-md mt-2">Formations proches</h2>
          </div>
          <Button variant="secondary" href="/catalogue/" icon="arrow-right">
            Tout le catalogue
          </Button>
        </div>
        <div class="viv-grid-cards">
          {proches.map((p) => (
            <FormationCard item={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="demande" class="viv-section bg-surface text-ink" data-theme="sombre">
    <div class="viv-wrap viv-split viv-split--form">
      <div>
        <p class="overline text-ink-muted">Demande</p>
        <h2 class="display-md mt-2 mb-4">Demander des dates pour cette formation</h2>
        <p class="body-lg text-ink-muted">
          Nous vous rappelons pour le cadrage d’une heure, puis nous fixons les dates avec vous.
        </p>
      </div>
      <ContactForm id="demande" sujet="dates" formation={f.titre} />
    </div>
  </section>
</BaseLayout>
