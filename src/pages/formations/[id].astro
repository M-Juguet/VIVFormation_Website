---
/* Page type : fiche d'une formation. Mêmes informations que la fiche programme imprimable
   (docs/design-system/templates/fiche-programme/), organisées pour le web comme un parcours de
   décision : est-ce pour nous, que saurons-nous faire, que contient la formation, comment est-elle
   validée, comment se déroule-t-elle, comment l'organiser. Une barre collante porte la navigation,
   le tarif et l'action ; tout ce qui sert à organiser (tarifs, délais, équipement, demande) est
   regroupé dans la bande sombre finale. */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarreFormation from '../../components/BarreFormation.astro';
import ContactForm from '../../components/ContactForm.astro';
import EvaluationFormation from '../../components/EvaluationFormation.astro';
import FormateurFormation from '../../components/FormateurFormation.astro';
import FormationCard from '../../components/FormationCard.astro';
import ModalitesFormation from '../../components/ModalitesFormation.astro';
import ObjectifsFormation from '../../components/ObjectifsFormation.astro';
import OrganiserFormation from '../../components/OrganiserFormation.astro';
import ProgrammeFormation from '../../components/ProgrammeFormation.astro';
import Badge from '../../components/ds/Badge.astro';
import Button from '../../components/ds/Button.astro';
import Icon from '../../components/ds/Icon.astro';
import { Image } from 'astro:assets';
import {
  formatDate,
  formationsProches,
  getFormations,
  resolveFormation,
  type FormationResolue,
} from '../../lib/formations';

export const getStaticPaths = (async () => {
  const toutes = await Promise.all((await getFormations()).map(resolveFormation));
  return toutes.map((item) => ({
    params: { id: item.formation.id },
    props: { item, proches: formationsProches(item, toutes) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  item: FormationResolue;
  proches: FormationResolue[];
}

const { item, proches } = Astro.props;
const f = item.formation.data;

// Le fil d'Ariane renvoie au catalogue filtré sur le domaine de la formation.
const catalogueDomaine = `/catalogue/?domaine=${item.domaine.id}`;
// Fiche programme PDF : public/programmes/<nom du fichier formation>.pdf, publiée telle quelle avec
// le site (adresse stable d'une version à l'autre). Téléchargée sous son nom documentaire
// <reference>-PRO-<version>.pdf. Sans fichier, le bouton n'apparaît pas.
const fichePdf = existsSync(join(process.cwd(), 'public', 'programmes', `${item.formation.id}.pdf`))
  ? `/programmes/${item.formation.id}.pdf`
  : undefined;
const fichePdfNom = `${f.reference}-PRO-${f.version}.pdf`;

const faits = [
  { icon: 'clock', label: item.duree },
  { icon: 'niveau', label: `Niveau : ${f.niveau.toLowerCase()}` },
] as const;
// « Dates à convenir » est le cas général : seul un statut de session mérite sa pastille ici.
const badges = item.badges.filter((b) => b.label !== 'Dates à convenir');

const sections = [
  { id: 'public', label: 'Public' },
  { id: 'objectifs', label: 'Objectifs' },
  { id: 'programme', label: 'Programme' },
  { id: 'evaluation', label: 'Évaluation' },
  { id: 'deroulement', label: 'Déroulement' },
  ...(item.formateur ? [{ id: 'formateur', label: 'Formateur' }] : []),
  { id: 'organiser', label: 'Tarifs' },
];

// Mention du visuel de couverture : crédit et, pour un visuel d'IA, « Image générée avec <outil> ».
const mentionVisuel = [f.visuelCredit, f.visuelIA && `Image générée avec ${f.visuelIA}`]
  .filter(Boolean)
  .join(' · ');

const modules = f.programme.length;
// Chiffres clés en tête du programme, tirés du fichier formation.
const chiffresProgramme = [
  { icon: 'box', label: `${modules} module${modules > 1 ? 's' : ''}` },
  { icon: 'clock', label: item.duree },
  { icon: 'map-pin', label: 'Présentiel' },
] as const;
const reference = `Référence ${f.reference} · version ${f.version} · programme révisé le ${formatDate(f.revision)}.`;
---

<BaseLayout title={f.titre} description={f.sousTitre} image={f.visuel} imageAlt={f.visuelAlt}>
  <BarreFormation
    titreCourt={f.titreCourt}
    sections={sections}
    apres="presentation"
    avant="organiser"
  />

  <section
    id="presentation"
    class:list={[
      'viv-section relative overflow-hidden bg-surface-brand text-ink',
      mentionVisuel && 'max-md:pb-16',
    ]}
    data-theme="sombre"
  >
    {f.visuel && (
      <div
        aria-hidden="true"
        class="viv-entete-visuel pointer-events-none absolute inset-y-0 right-0 w-full max-md:opacity-40 md:w-[70%]"
      >
        <Image
          src={f.visuel}
          alt=""
          widths={[800, 1280, 1920]}
          sizes="(max-width: 900px) 100vw, 70vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
      </div>
    )}
    <div class="viv-wrap relative">
      <nav aria-label="Fil d’Ariane" class="body-sm">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="text-ink-muted no-underline hover:text-ink">
              Accueil
            </a>
          </li>
          <li aria-hidden="true" class="flex text-ink-subtle">
            <Icon name="chevron-right" size={16} />
          </li>
          <li>
            <a href="/catalogue/" class="text-ink-muted no-underline hover:text-ink">
              Catalogue
            </a>
          </li>
          <li aria-hidden="true" class="flex text-ink-subtle">
            <Icon name="chevron-right" size={16} />
          </li>
          <li>
            <a href={catalogueDomaine} class="text-ink-muted no-underline hover:text-ink">
              {item.domaine.data.label}
            </a>
          </li>
        </ol>
      </nav>

      <div class="viv-split viv-split--aside-lg mt-8">
        <div>
          <p class="overline text-ink-muted">{item.overline}</p>
          <h1 class="display-lg mt-2 mb-5 text-balance">{f.titre}</h1>
          <div class="mb-6 flex flex-wrap gap-2">
            {badges.map((b) => (
              <Badge tone={b.tone}>{b.label}</Badge>
            ))}
          </div>
          <p class="body-lg max-w-[64ch] text-pretty text-ink-muted">{f.sousTitre}</p>
        </div>

        <div class="viv-glass p-6">
          <ul class="mb-5 flex flex-col gap-3">
            {faits.map((r) => (
              <li class="flex items-start gap-3">
                <span class="flex pt-0.5 text-action">
                  <Icon name={r.icon} />
                </span>
                <span class="body">{r.label}</span>
              </li>
            ))}
          </ul>
          {/* Tarifs inter et intra, toujours ensemble (le tarif intra est toujours sur devis). */}
          <dl class="mb-5 flex flex-col gap-2 border-y border-border py-4">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <dt class="body-sm text-ink-muted">Inter-entreprises</dt>
              <dd>
                {item.tarif ? (
                  <>
                    <span class="display-md">{item.tarif}</span>{' '}
                    <span class="caption text-ink-muted">HT/pers.</span>
                  </>
                ) : (
                  <span class="display-md">Sur devis</span>
                )}
              </dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <dt class="body-sm text-ink-muted">Intra-entreprise</dt>
              <dd class="heading-md">Sur devis</dd>
            </div>
          </dl>
          <Button href="#demande" icon="calendar" class="w-full">
            Demander des dates
          </Button>
          {fichePdf && (
            <Button
              variant="secondary"
              size="sm"
              href={fichePdf}
              download={fichePdfNom}
              icon="download"
              class="mt-3 w-full"
            >
              Télécharger le programme
            </Button>
          )}
        </div>
      </div>
    </div>
    {mentionVisuel && (
      <p class="viv-glass caption absolute right-4 bottom-3 rounded-pill px-3 py-1 text-ink-muted">
        {mentionVisuel}
      </p>
    )}
  </section>

  <!-- Est-ce pour nous ? -->
  <section id="public" class="viv-section bg-surface">
    <div class="viv-wrap">
      <div class="mb-10 max-w-[720px]">
        <p class="overline text-ink-muted">Public et prérequis</p>
        <h2 class="display-md mt-2">À qui s’adresse cette formation</h2>
      </div>
      <div class="viv-split viv-split--even">
        <div>
          <h3 class="heading-sm flex items-center gap-2 text-accent-deep">
            <Icon name="users" />
            Pour qui
          </h3>
          <ul class="mt-5 flex flex-wrap gap-3">
            {f.public.map((p) => (
              <li class="body rounded-pill bg-surface-brand px-4 py-2 text-ink">{p}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="heading-sm flex items-center gap-2 text-accent-deep">
            <Icon name="circle-check" />
            Prérequis
          </h3>
          <ul class="mt-5 flex flex-col gap-3">
            {f.prerequis.map((p) => (
              <li class="body flex items-start gap-3">
                <span class="flex pt-0.5 text-action">
                  <Icon name="check" />
                </span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Que saurons-nous faire ? -->
  <section id="objectifs" class="viv-section bg-surface-sunken">
    <div class="viv-wrap">
      <div class="mb-10 max-w-[720px]">
        <p class="overline text-ink-muted">Objectifs</p>
        <h2 class="display-md mt-2">Objectifs et compétences visées</h2>
      </div>
      <ObjectifsFormation objectifs={f.objectifs} competences={f.competences} />
    </div>
  </section>

  <!-- Que contient la formation ? -->
  <section id="programme" class="viv-section bg-surface">
    <div class="viv-wrap">
      <div class="mb-12 max-w-[720px]">
        <p class="overline text-ink-muted">Programme</p>
        <h2 class="display-md mt-2">Programme détaillé</h2>
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {chiffresProgramme.map((c) => (
            <li class="body-lg flex items-center gap-2 text-ink-muted">
              <span class="flex text-action">
                <Icon name={c.icon} />
              </span>
              {c.label}
            </li>
          ))}
        </ul>
      </div>
      <ProgrammeFormation programme={f.programme} />
    </div>
  </section>

  <!-- Comment est-elle validée ? -->
  <section id="evaluation" class="viv-section bg-(image:--gradient-brand)">
    <div class="viv-wrap">
      <div class="mb-10 max-w-[720px]">
        <p class="overline text-ink-on-pastel">Évaluation</p>
        <h2 class="display-md mt-2 text-ink-on-pastel">Évaluation et validation</h2>
      </div>
      <EvaluationFormation objectifs={f.objectifs.length} />
    </div>
  </section>

  <!-- Comment se déroule-t-elle ? -->
  <section id="deroulement" class="viv-section bg-surface-sunken">
    <div class="viv-wrap">
      <div class="mb-10 max-w-[720px]">
        <p class="overline text-ink-muted">Déroulement</p>
        <h2 class="display-md mt-2">Comment se déroule la formation</h2>
      </div>
      <ModalitesFormation materielFourni={f.materielFourni} />
    </div>
  </section>

  <!-- Qui anime ? Section facultative : seulement si la formation désigne un formateur. -->
  {item.formateur && (
    <section id="formateur" class="viv-section bg-surface">
      <div class="viv-wrap">
        <FormateurFormation formateur={item.formateur} domaine={item.domaine.id} />
      </div>
    </section>
  )}

  {proches.length > 0 && (
    <section class:list={['viv-section', item.formateur ? 'bg-surface-sunken' : 'bg-surface']}>
      <div class="viv-wrap">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="overline text-ink-muted">Pour aller plus loin</p>
            <h2 class="display-md mt-2">Formations proches</h2>
          </div>
          <Button variant="secondary" href="/catalogue/" icon="arrow-right">
            Tout le catalogue
          </Button>
        </div>
        <div class="viv-grid-cards">
          {proches.map((p) => (
            <FormationCard item={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Comment l'organiser ? Tarifs, délais, équipement, puis la demande -->
  <section id="organiser" class="viv-section bg-surface text-ink" data-theme="sombre">
    <div class="viv-wrap">
      <div class="mb-10 max-w-[720px]">
        <p class="overline text-ink-muted">Tarifs et accès</p>
        <h2 class="display-md mt-2">Organiser votre session</h2>
      </div>
      <OrganiserFormation tarif={item.tarif} equipement={f.equipement} />

      <div id="demande" class="viv-split viv-split--form mt-16 border-t border-border pt-16">
        <div>
          <p class="overline text-ink-muted">Demande</p>
          <h2 class="display-md mt-2 mb-4">Demander des dates pour cette formation</h2>
          <p class="body-lg text-ink-muted">
            Nous vous rappelons pour le cadrage d’une heure, puis nous fixons les dates avec vous.
          </p>
          <p class="caption mt-8 text-ink-muted">{reference}</p>
        </div>
        <ContactForm id="demande" sujet="dates" formation={f.titre} />
      </div>
    </div>
  </section>
</BaseLayout>
