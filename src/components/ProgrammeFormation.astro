---
/* Programme détaillé en frise verticale : le vocabulaire de ProgramSteps (pastilles numérotées,
   filet de liaison, état « en cours » en couleur d'action), en deux colonnes pour le web — titre
   du module à gauche, points à droite. La pastille du module en cours de lecture passe en couleur
   d'action au défilement ; rien d'autre ne bouge. */
interface Props {
  programme: { titre: string; points: string[] }[];
}

const { programme } = Astro.props;
---

<ol class="viv-steps" data-programme>
  {programme.map((p, i) => (
    <li class="viv-steps__item pb-10 last:pb-0 md:pb-14" data-module>
      <span class="viv-steps__dot">{i + 1}</span>
      <div class="grid min-w-0 flex-1 gap-3 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10">
        <div class="pt-1">
          <p class="overline text-ink-muted">Module {i + 1}</p>
          <h3 class="heading-md mt-1 text-balance">{p.titre}</h3>
        </div>
        <ul class="body flex list-disc flex-col gap-2 pl-5 marker:text-brand-rose md:pt-1">
          {p.points.map((pt) => (
            <li>{pt}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>

<script>
  const modules = [...document.querySelectorAll<HTMLElement>('[data-programme] [data-module]')];
  if (modules.length) {
    const frise = modules[0].parentElement!;
    let courant: HTMLElement | null = null;
    let enAttente = false;
    const suivre = () => {
      enAttente = false;
      const repere = innerHeight * 0.45;
      const cadre = frise.getBoundingClientRect();
      let actif: HTMLElement | null = null;
      if (cadre.top <= repere && cadre.bottom >= repere) {
        for (const m of modules) if (m.getBoundingClientRect().top <= repere) actif = m;
      }
      if (actif === courant) return;
      courant?.classList.remove('viv-steps__item--current');
      actif?.classList.add('viv-steps__item--current');
      courant = actif;
    };
    const planifier = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(suivre);
    };
    addEventListener('scroll', planifier, { passive: true });
    suivre();
  }
</script>
