---
/* Programme détaillé. Grand écran : à gauche, un index collant des modules en frise (pastilles de
   ProgramSteps sur un fil qui se remplit jusqu'au module en cours de lecture) ; à droite, une carte
   par module. L'index suit la lecture (module en cours : pastille d'action avec halo, titre en
   encre pleine ; les autres en encre atténuée) et chaque entrée est un lien vers son module.
   Mobile : l'index disparaît, les cartes s'empilent. Sans script, l'index reste une liste de liens.
   Styles d'état dans global.css (`.viv-programme`). */
interface Props {
  programme: { titre: string; points: string[] }[];
}

const { programme } = Astro.props;
const total = programme.length;

/** « Intitulé : détail » → intitulé en encre pleine, détail atténué ; sinon le point tel quel. */
const decouper = (point: string) => {
  const m = point.match(/^(.{3,80}?)\s:\s(.+)$/);
  return m ? { intitule: m[1], detail: m[2] } : { intitule: point };
};
---

<div
  class="viv-programme grid gap-8 md:grid-cols-[260px_minmax(0,1fr)] md:gap-12 lg:grid-cols-[300px_minmax(0,1fr)]"
  data-programme
>
  <nav aria-label="Modules du programme" class="hidden md:block">
    <div class="sticky top-44 max-h-[calc(100vh-12rem)] overflow-y-auto pb-2">
      <p class="overline text-ink-muted">
        Module <span data-compteur>1</span> sur {total}
      </p>
      <ol class="relative mt-4 flex flex-col" data-index>
        <span
          aria-hidden="true"
          data-fil
          class="absolute top-0 bottom-0 left-[15px] w-0.5 bg-border"
        ></span>
        <span
          aria-hidden="true"
          data-fil-rempli
          class="viv-programme__rempli absolute top-0 left-[15px] h-0 w-0.5 bg-action"
        ></span>
        {programme.map((p, i) => (
          <li>
            <a
              href={`#module-${i + 1}`}
              data-lien-module
              class="viv-programme__lien group flex items-start gap-3 py-2 no-underline"
            >
              <span data-pastille class="viv-steps__dot">
                {i + 1}
              </span>
              <span class="body pt-1 text-ink-muted transition-colors duration-(--motion-micro) ease-standard group-hover:text-ink group-aria-[current=step]:text-ink">
                {p.titre}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <ol class="flex flex-col gap-6">
    {programme.map((p, i) => (
      <li id={`module-${i + 1}`} data-module class="viv-card p-6 md:p-8">
        <p class="overline text-ink-muted">
          Module {i + 1} sur {total}
        </p>
        <h3 class="heading-lg mt-1 text-balance">{p.titre}</h3>
        <ul class="mt-5 flex max-w-[68ch] flex-col gap-4">
          {p.points.map(decouper).map(({ intitule, detail }) => (
            <li class="flex gap-3">
              <span
                aria-hidden="true"
                class="mt-2.5 size-1.5 shrink-0 rounded-pill bg-brand-rose"
              />
              <span>
                <span class="body block text-ink">{intitule}</span>
                {detail && <span class="body mt-0.5 block text-ink-muted">{detail}</span>}
              </span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</div>

<script>
  for (const bloc of document.querySelectorAll<HTMLElement>('[data-programme]')) {
    const modules = [...bloc.querySelectorAll<HTMLElement>('[data-module]')];
    const liens = [...bloc.querySelectorAll<HTMLAnchorElement>('[data-lien-module]')];
    const pastilles = liens.map((l) => l.querySelector<HTMLElement>('[data-pastille]')!);
    const index = bloc.querySelector<HTMLElement>('[data-index]');
    const fil = bloc.querySelector<HTMLElement>('[data-fil]');
    const rempli = bloc.querySelector<HTMLElement>('[data-fil-rempli]');
    const compteur = bloc.querySelector<HTMLElement>('[data-compteur]');
    let courant = -1;

    // Centre vertical d'une pastille, par rapport au haut de l'index.
    const centre = (p: HTMLElement) => {
      const r = p.getBoundingClientRect();
      return r.top + r.height / 2 - index!.getBoundingClientRect().top;
    };

    // Le fil court de la première à la dernière pastille ; le remplissage part du même point.
    const tracerFil = () => {
      if (!index || pastilles.length < 2) return;
      const debut = centre(pastilles[0]);
      for (const trait of [fil, rempli]) if (trait) trait.style.top = `${debut}px`;
      if (fil) {
        fil.style.bottom = 'auto';
        fil.style.height = `${centre(pastilles[pastilles.length - 1]) - debut}px`;
      }
    };

    const marquer = (n: number) => {
      if (n === courant) return;
      courant = n;
      liens.forEach((l, i) => {
        if (i === n) l.setAttribute('aria-current', 'step');
        else l.removeAttribute('aria-current');
      });
      if (compteur) compteur.textContent = String(n + 1);
      if (rempli && index) rempli.style.height = `${centre(pastilles[n]) - centre(pastilles[0])}px`;
    };

    // Module en cours de lecture : le dernier dont le haut a passé le repère (le premier par défaut).
    let enAttente = false;
    const suivre = () => {
      enAttente = false;
      const repere = innerHeight * 0.4;
      let n = 0;
      modules.forEach((m, i) => {
        if (m.getBoundingClientRect().top <= repere) n = i;
      });
      marquer(n);
    };
    const planifier = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(suivre);
    };

    addEventListener('scroll', planifier, { passive: true });
    addEventListener('resize', () => {
      tracerFil();
      courant = -1;
      planifier();
    });
    tracerFil();
    suivre();
  }
</script>
