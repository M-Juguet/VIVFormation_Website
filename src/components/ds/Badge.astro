---
/* Étiquette courte qui qualifie une formation ou une session : outil, modalité, statut.
   Portage de docs/design-system/components/base/Badge.jsx. */
import Icon from './Icon.astro';
import type { IconName } from './icons';

export type BadgeTone =
  'rose' | 'peach' | 'gold' | 'neutral' | 'success' | 'warning' | 'danger' | 'info';

interface Props {
  tone?: BadgeTone;
  icon?: IconName;
  class?: string;
}

const { tone = 'neutral', icon, class: className } = Astro.props;
---

<span class:list={['viv-badge', `viv-badge--${tone}`, className]}>
  {icon && (
    <span aria-hidden="true">
      <Icon name={icon} size={16} />
    </span>
  )}
  <slot />
</span>
