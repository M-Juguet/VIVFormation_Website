---
/* Carte catalogue d'une formation : ModuleCard du design system alimentée par le contenu.
   Ni description ni tarif : ils sont réservés à la page de la formation. */
import ModuleCard from './ds/ModuleCard.astro';
import type { FormationResolue } from '../lib/formations';

interface Props {
  item: FormationResolue;
  class?: string;
}

const { item, class: className } = Astro.props;
const d = item.formation.data;
// « Présentiel » et « Dates à convenir » valent pour toutes les formations : la carte ne garde que
// les outils, un statut de session particulier et la mention d'exemple provisoire.
const badges = item.badges.filter(
  (b) => b.label !== 'Présentiel' && b.label !== 'Dates à convenir',
);
---

<ModuleCard
  class={className}
  image={d.visuel}
  imageAlt={d.visuelAlt}
  imagePlaceholder="Rendu ou capture d’un fichier d’exercice"
  mark={item.mark}
  overline={item.overline}
  title={d.titre}
  meta={[
    { label: 'Durée', value: item.duree },
    { label: 'Niveau', value: d.niveau },
  ]}
  badges={badges}
  href={item.url}
  actionLabel="Voir la fiche"
/>
