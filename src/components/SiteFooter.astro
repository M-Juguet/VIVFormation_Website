---
import Logo from './ds/Logo.astro';
import { SITE } from '../config/site';
import { getTaxonomies } from '../lib/formations';

const { domaines } = await getTaxonomies();
const lien = 'text-ink-muted no-underline hover:text-ink';
const aPropos = [
  { href: '/mentions-legales/', label: 'Mentions légales' },
  { href: '/conditions-generales-de-vente/', label: 'Conditions générales de vente' },
];
const { rue, codePostal, ville } = SITE.adresse;
// Recherche Google Maps par adresse : format d'URL public, sans clé d'API.
const plan = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${rue}, ${codePostal} ${ville}`)}`;
---

<footer data-theme="sombre" class="bg-surface-sunken text-ink">
  <div class="viv-wrap viv-footer-grid py-12">
    <div class="flex flex-col items-start gap-3">
      <Logo mark="monogramme" variant="blanc" height={40} />
      <p class="body-sm m-0 max-w-[300px] text-ink-muted">
        Formations professionnelles à la conception 3D, au graphisme 2D et à l’IA générative
        appliquée au travail quotidien.
      </p>
    </div>
    <div>
      <p class="overline mb-3 text-ink-muted">Formations</p>
      <ul class="flex flex-col gap-2">
        <li class="body-sm">
          <a href="/catalogue/" class={lien}>
            Catalogue complet
          </a>
        </li>
        {domaines.map((d) => (
          <li class="body-sm">
            <a href={`/catalogue/?domaine=${d.id}`} class={lien}>
              {d.data.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="overline mb-3 text-ink-muted">À propos</p>
      <ul class="flex flex-col gap-2">
        {aPropos.map(({ href, label }) => (
          <li class="body-sm">
            <a href={href} class={lien}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="overline mb-3 text-ink-muted">Contact</p>
      <address class="not-italic">
        <ul class="flex flex-col gap-2">
          <li class="body-sm">
            <a href={plan} target="_blank" rel="noopener noreferrer" class={lien}>
              {rue}
              <br />
              {codePostal} {ville}
              <span class="sr-only"> (voir le plan, nouvel onglet)</span>
            </a>
          </li>
          <li class="body-sm">
            <a href={`mailto:${SITE.email}`} class={lien}>
              {SITE.email}
            </a>
          </li>
          <li class="body-sm">
            <a href="/contact/" class={lien}>
              Formulaire de contact
            </a>
          </li>
        </ul>
      </address>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="caption viv-wrap py-5 text-ink-subtle">
      {SITE.name} — numéro de déclaration d’activité {SITE.declarationActivite}. Accessibilité :
      dites-nous ce qu’il faut adapter, nous organisons la session en conséquence. Toutes les
      formations se tiennent en présentiel ; les dates se fixent avec vous.
    </p>
  </div>
</footer>
