---
/* Motif de couverture de la marque : blocs pastel posés au pas de 32 px, disques et pilules découpés
   à la couleur du fond (voir docs/design-system/guidelines/brand-couverture.card.html).
   `cutout` doit être la couleur de fond de la section qui l'accueille. */
interface Props {
  cutout?: string;
  class?: string;
}

const { cutout = 'var(--surface-brand)', class: className } = Astro.props;
const disques = [
  [128, 24, 14],
  [128, 80, 14],
  [128, 136, 14],
  [128, 192, 14],
  [128, 248, 14],
  [264, 96, 14],
  [312, 96, 14],
  [360, 96, 14],
  [272, 240, 16],
  [272, 368, 14],
];
---

<svg viewBox="0 0 480 448" class:list={['block h-auto w-full', className]} aria-hidden="true">
  <rect x="64" y="-40" width="128" height="528" rx="28" fill="var(--brand-rose)"></rect>
  <rect x="224" y="32" width="256" height="128" rx="18" fill="var(--brand-peach)"></rect>
  <rect x="224" y="192" width="96" height="96" rx="18" fill="var(--action)"></rect>
  <rect x="352" y="192" width="128" height="224" rx="18" fill="var(--brand-gold)"></rect>
  <rect x="224" y="320" width="96" height="96" rx="18" fill="var(--brand-peach)"></rect>
  {disques.map(([cx, cy, r]) => (
    <circle cx={cx} cy={cy} r={r} fill={cutout} />
  ))}
  <rect x="400" y="80" width="48" height="32" rx="16" fill={cutout}></rect>
  <rect x="400" y="224" width="32" height="160" rx="16" fill={cutout}></rect>
</svg>
